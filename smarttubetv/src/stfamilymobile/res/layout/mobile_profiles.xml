<?xml version="1.0" encoding="utf-8"?>
<!-- Phone version of "¿Quién está viendo?" and the profile editor (same element names as the TV one) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/family_bg"
    android:clickable="true">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/family_picker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingLeft="24dp"
            android:paddingTop="40dp"
            android:paddingRight="24dp"
            android:paddingBottom="40dp">

            <TextView
                android:id="@+id/family_picker_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="¿Quién está viendo?"
                android:textColor="@color/family_text"
                android:textSize="26sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/family_picker_items"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/family_picker_manage"
                style="@style/MobileChip"
                android:layout_marginTop="24dp"
                android:text="Gestionar perfiles" />
        </LinearLayout>
    </ScrollView>

    <ScrollView
        android:id="@+id/family_editor"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="20dp"
            android:paddingTop="24dp"
            android:paddingRight="20dp"
            android:paddingBottom="40dp">

            <TextView
                android:id="@+id/family_editor_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/family_text"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                style="@style/MobileLabel"
                android:text="Nombre" />

            <EditText
                android:id="@+id/family_editor_name"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/family_input_bg"
                android:hint="Por ejemplo, Lucía"
                android:importantForAutofill="no"
                android:inputType="textPersonName|textCapWords"
                android:maxLength="20"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:singleLine="true"
                android:textColor="@color/family_text"
                android:textColorHint="@color/family_text3"
                android:textSize="17sp" />

            <TextView
                style="@style/MobileLabel"
                android:text="Cuenta de Google" />

            <TextView
                android:id="@+id/family_editor_account"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/family_input_bg"
                android:clickable="true"
                android:focusable="true"
                android:minHeight="48dp"
                android:gravity="center_vertical"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:textColor="@color/family_text"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Sus suscripciones, historial y listas. Al elegir el perfil, la app cambia a esa cuenta."
                android:textColor="@color/family_text3"
                android:textSize="13sp" />

            <TextView
                style="@style/MobileLabel"
                android:text="Imagen" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/family_editor_avatars"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <TextView
                style="@style/MobileLabel"
                android:text="Tipo de perfil" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/family_tabs_bg"
                android:orientation="horizontal"
                android:padding="4dp">

                <TextView
                    android:id="@+id/family_editor_adult"
                    style="@style/MobileChip"
                    android:text="Adulto" />

                <TextView
                    android:id="@+id/family_editor_kid"
                    style="@style/MobileChip"
                    android:text="Infantil" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/family_editor_adult_options"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/MobileLabel"
                    android:text="Shorts" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/family_tabs_bg"
                    android:orientation="horizontal"
                    android:padding="4dp">

                    <TextView
                        android:id="@+id/family_editor_shorts_show"
                        style="@style/MobileChip"
                        android:text="Mostrar" />

                    <TextView
                        android:id="@+id/family_editor_shorts_hide"
                        style="@style/MobileChip"
                        android:text="Ocultar" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/family_editor_kid_options"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/MobileLabel"
                    android:text="Edad" />

                <LinearLayout
                    android:id="@+id/family_editor_ages"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/family_tabs_bg"
                    android:orientation="horizontal"
                    android:padding="4dp">

                    <TextView style="@style/MobileChip" android:text="Hasta 4" />
                    <TextView style="@style/MobileChip" android:text="5 a 8" />
                    <TextView style="@style/MobileChip" android:text="9 a 12" />
                    <TextView style="@style/MobileChip" android:text="13 a 15" />
                </LinearLayout>

                <TextView
                    style="@style/MobileLabel"
                    android:text="Qué puede ver" />

                <LinearLayout
                    android:id="@+id/family_editor_content"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/family_tabs_bg"
                    android:orientation="vertical"
                    android:padding="4dp">

                    <TextView style="@style/MobileChip" android:text="Todo menos contenido adulto" />
                    <TextView style="@style/MobileChip" android:text="Solo canales aprobados" />
                </LinearLayout>

                <TextView
                    android:id="@+id/family_editor_content_hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/family_text3"
                    android:textSize="13sp" />

                <TextView
                    style="@style/MobileLabel"
                    android:text="Tiempo máximo al día" />

                <LinearLayout
                    android:id="@+id/family_editor_limits"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/family_tabs_bg"
                    android:orientation="horizontal"
                    android:padding="4dp">

                    <TextView style="@style/MobileChip" android:text="Sin límite" />
                    <TextView style="@style/MobileChip" android:text="30 min" />
                    <TextView style="@style/MobileChip" android:text="1 h" />
                    <TextView style="@style/MobileChip" android:text="2 h" />
                </LinearLayout>

                <TextView
                    style="@style/MobileLabel"
                    android:text="Comentarios y chat" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/family_tabs_bg"
                    android:orientation="horizontal"
                    android:padding="4dp">

                    <TextView
                        android:id="@+id/family_editor_comments_hide"
                        style="@style/MobileChip"
                        android:text="Ocultar" />

                    <TextView
                        android:id="@+id/family_editor_comments_show"
                        style="@style/MobileChip"
                        android:text="Mostrar" />
                </LinearLayout>

                <TextView
                    style="@style/MobileLabel"
                    android:text="Canales aprobados" />

                <LinearLayout
                    android:id="@+id/family_editor_channels"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Para aprobar un canal: desde un perfil de adulto, mantén pulsado un vídeo de ese canal."
                    android:textColor="@color/family_text3"
                    android:textSize="13sp" />

                <LinearLayout
                    android:id="@+id/family_editor_pin_box"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Al guardar elegirás un PIN de 4 cifras. Se pedirá para entrar en los perfiles de adulto, para dar más tiempo y para cambiar estos ajustes."
                        android:textColor="@color/family_text3"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/family_editor_save"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:background="@drawable/family_pill_red"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:paddingLeft="24dp"
                    android:paddingRight="24dp"
                    android:text="Guardar"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/family_editor_delete"
                    style="@style/MobileChip"
                    android:layout_height="42dp"
                    android:layout_marginLeft="10dp"
                    android:text="Borrar" />

                <TextView
                    android:id="@+id/family_editor_cancel"
                    style="@style/MobileChip"
                    android:layout_height="42dp"
                    android:layout_marginLeft="10dp"
                    android:text="Cancelar" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
