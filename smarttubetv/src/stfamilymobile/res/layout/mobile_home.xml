<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mobile_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/family_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top bar: logo / greeting · search · profile · settings -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/mobile_bar"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="14dp"
            android:paddingRight="6dp">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:importantForAccessibility="no"
                android:src="@drawable/family_ic_home" />

            <TextView
                android:id="@+id/family_logo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="@string/app_name"
                android:textColor="@color/family_text"
                android:textSize="18sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/mobile_search"
                style="@style/MobileIconButton"
                android:contentDescription="Buscar"
                android:src="@drawable/mobile_ic_search" />

            <TextView
                android:id="@+id/family_profile_button"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginLeft="6dp"
                android:layout_marginRight="6dp"
                android:clickable="true"
                android:contentDescription="Cambiar de perfil"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/family_settings"
                style="@style/MobileIconButton"
                android:contentDescription="Ajustes"
                android:src="@drawable/mobile_ic_settings" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/mobile_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="16dp" />

            <LinearLayout
                android:id="@+id/family_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="28dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/family_message_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:lineSpacingMultiplier="1.2"
                    android:textColor="@color/family_text2"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/family_message_action"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/family_pill_red"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:paddingLeft="24dp"
                    android:paddingRight="24dp"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/family_progress"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:indeterminateTint="@color/family_ring"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Bottom bar: Inicio · Suscripciones · Biblioteca -->
        <LinearLayout
            android:id="@+id/mobile_nav"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:background="#16181C"
            android:orientation="horizontal" />
    </LinearLayout>

    <!-- Welcome screen: every time the app is opened, while Suscripciones and Biblioteca load -->
    <LinearLayout
        android:id="@+id/family_welcome"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/family_bg"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <ImageView
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:src="@mipmap/app_icon" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="sans-serif-medium"
            android:text="MyFamilyTube"
            android:textColor="@color/family_text"
            android:textSize="30sp"
            android:textStyle="bold" />

        <ProgressBar
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginTop="24dp"
            android:indeterminateTint="@color/family_ring" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Preparando tus vídeos…"
            android:textColor="@color/family_text3"
            android:textSize="15sp" />
    </LinearLayout>
</FrameLayout>
