<?xml version="1.0" encoding="utf-8"?>
<!-- One video in a phone list: big 16:9 picture, title and channel underneath -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:paddingBottom="16dp">

    <FrameLayout
        android:id="@+id/family_card_thumb_frame"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_marginLeft="@dimen/mobile_side"
        android:layout_marginRight="@dimen/mobile_side"
        android:background="@drawable/family_thumb_bg">

        <ImageView
            android:id="@+id/mobile_card_thumb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <TextView
            android:id="@+id/mobile_card_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="8dp"
            android:background="@drawable/family_badge_bg"
            android:fontFamily="sans-serif-medium"
            android:paddingLeft="6dp"
            android:paddingTop="1dp"
            android:paddingRight="6dp"
            android:paddingBottom="1dp"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:visibility="gone" />

        <!-- Preview sound on/off (only on the card that is playing) -->
        <ImageView
            android:id="@+id/mobile_card_sound"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="top|end"
            android:layout_margin="8dp"
            android:background="@drawable/mobile_round_dark"
            android:contentDescription="Sonido"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/mobile_ic_volume_off"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/mobile_card_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="10dp"
        android:layout_marginRight="16dp"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:maxLines="2"
        android:textColor="@color/family_text"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/mobile_card_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="3dp"
        android:layout_marginRight="16dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/family_text3"
        android:textSize="13sp" />
</LinearLayout>
