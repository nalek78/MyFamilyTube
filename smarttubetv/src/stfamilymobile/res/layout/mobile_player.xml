<?xml version="1.0" encoding="utf-8"?>
<!-- Phone player: video on top (whole screen when turned sideways), then the video's
     details, the action buttons and the suggested videos -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mobile_player_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/family_bg"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/mobile_video_frame"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:background="@android:color/black">

        <com.google.android.exoplayer2.ui.PlayerView
            android:id="@+id/mobile_player_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:resize_mode="fit"
            app:shutter_background_color="@android:color/black"
            app:use_controller="false" />

        <!-- Takes the taps: one tap shows/hides the controls, a double tap jumps 10 s -->
        <View
            android:id="@+id/mobile_touch"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/mobile_seek_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/mobile_chip_bg"
            android:paddingLeft="16dp"
            android:paddingTop="8dp"
            android:paddingRight="16dp"
            android:paddingBottom="8dp"
            android:textColor="@color/family_text"
            android:textSize="16sp"
            android:visibility="gone" />

        <FrameLayout
            android:id="@+id/mobile_controls"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#73000000">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="4dp">

                <ImageView
                    android:id="@+id/mobile_player_back"
                    style="@style/MobileIconButton"
                    android:contentDescription="Atrás"
                    android:src="@drawable/mobile_ic_back" />

                <TextView
                    android:id="@+id/mobile_player_overlay_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:paddingLeft="4dp"
                    android:singleLine="true"
                    android:textColor="@color/family_text"
                    android:textSize="16sp" />

                <ImageView
                    android:id="@+id/mobile_player_quality"
                    style="@style/MobileIconButton"
                    android:contentDescription="Calidad"
                    android:src="@drawable/mobile_ic_settings" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/mobile_player_prev"
                    style="@style/MobileIconButton"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:contentDescription="Anterior"
                    android:src="@drawable/mobile_ic_prev" />

                <ImageView
                    android:id="@+id/mobile_player_play"
                    android:layout_width="76dp"
                    android:layout_height="76dp"
                    android:layout_marginLeft="28dp"
                    android:layout_marginRight="28dp"
                    android:background="@drawable/mobile_round_dark"
                    android:clickable="true"
                    android:contentDescription="Reproducir"
                    android:focusable="true"
                    android:scaleType="center"
                    android:src="@drawable/mobile_ic_pause" />

                <ImageView
                    android:id="@+id/mobile_player_next"
                    style="@style/MobileIconButton"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:contentDescription="Siguiente"
                    android:src="@drawable/mobile_ic_next" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="12dp"
                android:paddingRight="4dp">

                <TextView
                    android:id="@+id/mobile_player_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0:00"
                    android:textColor="@color/family_text"
                    android:textSize="12sp" />

                <SeekBar
                    android:id="@+id/mobile_player_seek"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:progressTint="@color/family_ring"
                    android:thumbTint="@color/family_ring" />

                <TextView
                    android:id="@+id/mobile_player_duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0:00"
                    android:textColor="@color/family_text2"
                    android:textSize="12sp" />

                <ImageView
                    android:id="@+id/mobile_player_fullscreen"
                    style="@style/MobileIconButton"
                    android:contentDescription="Pantalla completa"
                    android:src="@drawable/mobile_ic_fullscreen" />
            </LinearLayout>
        </FrameLayout>

        <ProgressBar
            android:id="@+id/mobile_player_buffering"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/family_ring"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Hidden in full screen -->
    <LinearLayout
        android:id="@+id/mobile_player_details"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/mobile_player_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="3"
            android:ellipsize="end"
            android:paddingLeft="@dimen/mobile_side"
            android:paddingTop="12dp"
            android:paddingRight="@dimen/mobile_side"
            android:textColor="@color/family_text"
            android:textSize="17sp"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/mobile_player_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:ellipsize="end"
            android:paddingLeft="@dimen/mobile_side"
            android:paddingTop="4dp"
            android:paddingRight="@dimen/mobile_side"
            android:textColor="@color/family_text3"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/mobile_player_channel"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:paddingLeft="@dimen/mobile_side"
            android:paddingRight="@dimen/mobile_side"
            android:singleLine="true"
            android:textColor="@color/family_text"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/mobile_player_actions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingLeft="6dp"
                android:paddingRight="6dp" />
        </HorizontalScrollView>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="6dp"
            android:background="@color/family_surface" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/mobile_player_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="12dp" />
    </LinearLayout>
</LinearLayout>
