<?xml version="1.0" encoding="utf-8"?>
<!-- MyFamilyTube for phones: overlays the upstream manifest with the touch screens -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.liskovsoft.smartyoutubetv2.tv">

    <!-- Not a TV-only app any more -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="false"
        tools:replace="android:required" />

    <!-- Keep playing with the screen off or in the floating window -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:name="es.myfamilytube.MobileApplication"
        tools:replace="android:name">

        <activity
            android:name="es.myfamilytube.ui.MobileHomeActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|layoutDirection|keyboardHidden"
            android:launchMode="singleTask"
            android:screenOrientation="unspecified"
            android:theme="@style/MobileTheme"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name="es.myfamilytube.ui.MobilePlayerActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|layoutDirection|keyboardHidden"
            android:launchMode="singleTask"
            android:screenOrientation="unspecified"
            android:resizeableActivity="true"
            android:supportsPictureInPicture="true"
            android:theme="@style/MobilePlayerTheme"
            tools:targetApi="n" />

        <!-- Android Auto: music (sound only) -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />
        <meta-data
            android:name="com.google.android.gms.car.notification.SmallIcon"
            android:resource="@drawable/mobile_ic_play" />

        <service
            android:name="es.myfamilytube.auto.CarMusicService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback"
            tools:targetApi="q">
            <intent-filter>
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <provider
            android:name="es.myfamilytube.auto.CarArtProvider"
            android:authorities="${applicationId}.art"
            android:exported="true"
            tools:ignore="ExportedContentProvider" />

        <service
            android:name="es.myfamilytube.ui.MobilePlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback"
            tools:targetApi="q" />

        <activity
            android:name="es.myfamilytube.ui.MobileSearchActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|layoutDirection|keyboardHidden"
            android:launchMode="singleTask"
            android:screenOrientation="unspecified"
            android:theme="@style/MobileTheme"
            android:windowSoftInputMode="adjustResize|stateVisible" />

        <!-- The TV start screen keeps only the app icon: links go to MobileLinkActivity -->
        <activity android:name="com.liskovsoft.smartyoutubetv2.tv.ui.main.SplashActivity">
            <intent-filter tools:node="remove">
                <action android:name="android.intent.action.VIEW"/>
                <action android:name="android.media.action.MEDIA_PLAY_FROM_SEARCH"/>
                <action android:name="android.nfc.action.NDEF_DISCOVERED"/>

                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>

                <data android:scheme="http"/>
                <data android:scheme="https"/>
                <data android:host="youtube.com"/>
                <data android:host="www.youtube.com"/>
                <data android:host="m.youtube.com"/>
                <data android:host="youtu.be"/>
                <data android:pathPattern=".*"/>
                <data android:host="search" android:scheme="youtube"/>
                <data android:host="play" android:scheme="youtube"/>
            </intent-filter>
            <intent-filter tools:node="remove">
                <action android:name="android.intent.action.VIEW"/>
                <action android:name="android.media.action.MEDIA_PLAY_FROM_SEARCH"/>
                <action android:name="android.nfc.action.NDEF_DISCOVERED"/>

                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>

                <data android:scheme="vnd.youtube"/>
                <data android:scheme="vnd.youtube.launch"/>
            </intent-filter>
            <intent-filter tools:node="remove">
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="text/plain"/>
            </intent-filter>
        </activity>

        <!-- YouTube links from other apps (not Shorts). Choose it in Android: Abrir de forma predeterminada -->
        <activity
            android:name="es.myfamilytube.ui.MobileLinkActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:label="@string/app_name"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="http" />
                <data android:scheme="https" />
                <data android:host="youtube.com" />
                <data android:host="www.youtube.com" />
                <data android:host="m.youtube.com" />
                <data android:pathPrefix="/watch" />
                <data android:pathPrefix="/live/" />
                <data android:pathPrefix="/playlist" />
                <data android:pathPrefix="/channel/" />
                <data android:pathPrefix="/@" />
                <data android:pathPrefix="/c/" />
                <data android:pathPrefix="/user/" />
                <data android:pathPrefix="/results" />
                <data android:pathPrefix="/shorts/" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="http" />
                <data android:scheme="https" />
                <data android:host="youtu.be" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="vnd.youtube" />
            </intent-filter>
            <!-- "Compartir" from the YouTube app or the browser -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <activity
            android:name="es.myfamilytube.ui.MobileSignInActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|layoutDirection|keyboardHidden"
            android:screenOrientation="unspecified"
            android:theme="@style/MobileTheme" />

        <activity
            android:name="es.myfamilytube.ui.MobileChannelActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|layoutDirection|keyboardHidden"
            android:screenOrientation="unspecified"
            android:theme="@style/MobileTheme" />

        <activity
            android:name="es.myfamilytube.ui.MobileChannelUploadsActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|layoutDirection|keyboardHidden"
            android:screenOrientation="unspecified"
            android:theme="@style/MobileTheme" />

    </application>
</manifest>
