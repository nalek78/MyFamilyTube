<?xml version="1.0" encoding="utf-8"?>
<!-- One profile on "¿Quién está viendo?". Extra room around the circle so the ring and zoom are never cut. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="168dp"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:focusable="true"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingLeft="6dp"
    android:paddingTop="10dp"
    android:paddingRight="6dp"
    android:paddingBottom="6dp">

    <TextView
        android:id="@+id/family_profile_avatar"
        android:layout_width="104dp"
        android:layout_height="104dp"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:includeFontPadding="false"
        android:textColor="#FFFFFF"
        android:textSize="40sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/family_profile_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:maxLines="2"
        android:textColor="@color/family_text"
        android:textSize="17sp" />

    <TextView
        android:id="@+id/family_profile_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:lineSpacingMultiplier="1.1"
        android:maxLines="3"
        android:textColor="@color/family_text3"
        android:textSize="13sp" />
</LinearLayout>
