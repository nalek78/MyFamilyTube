<?xml version="1.0" encoding="utf-8"?>
<!-- "¿Quién está viendo?" and the profile editor, shown over the home screen -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/family_bg"
    android:clickable="true"
    android:clipChildren="false">

    <LinearLayout
        android:id="@+id/family_picker"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/family_picker_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="¿Quién está viendo?"
            android:textColor="@color/family_text"
            android:textSize="30sp"
            android:textStyle="bold" />

        <HorizontalScrollView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:fillViewport="false"
            android:paddingLeft="40dp"
            android:paddingRight="40dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/family_picker_items"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:paddingTop="10dp"
                android:paddingBottom="10dp" />
        </HorizontalScrollView>

        <TextView
            android:id="@+id/family_picker_manage"
            style="@style/FamilyTab"
            android:layout_marginTop="30dp"
            android:text="Gestionar perfiles" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/family_editor"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="32dp"
            android:paddingBottom="48dp">

            <TextView
                android:id="@+id/family_editor_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/family_text"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                style="@style/FamilyLabel"
                android:text="Nombre" />

            <EditText
                android:id="@+id/family_editor_name"
                android:layout_width="360dp"
                android:layout_height="48dp"
                android:background="@drawable/family_input_bg"
                android:hint="Por ejemplo, Lucía"
                android:importantForAutofill="no"
                android:inputType="textPersonName|textCapWords"
                android:maxLength="20"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:singleLine="true"
                android:textColor="@color/family_text"
                android:textColorHint="@color/family_text3"
                android:textSize="18sp" />

            <TextView
                style="@style/FamilyLabel"
                android:text="Cuenta de Google" />

            <TextView
                android:id="@+id/family_editor_account"
                style="@style/FamilyTab"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/family_input_bg"
                android:maxWidth="520dp"
                android:paddingLeft="18dp"
                android:paddingRight="18dp" />

            <TextView
                android:layout_width="480dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="Sus suscripciones, historial y listas. Al elegir el perfil, la app cambia a esa cuenta."
                android:textColor="@color/family_text3"
                android:textSize="13sp" />

            <TextView
                style="@style/FamilyLabel"
                android:text="Imagen" />

            <LinearLayout
                android:id="@+id/family_editor_avatars"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:padding="4dp" />

            <TextView
                style="@style/FamilyLabel"
                android:text="Tipo de perfil" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/family_tabs_bg"
                android:orientation="horizontal"
                android:padding="4dp">

                <TextView
                    android:id="@+id/family_editor_adult"
                    style="@style/FamilyTab"
                    android:text="Adulto" />

                <TextView
                    android:id="@+id/family_editor_kid"
                    style="@style/FamilyTab"
                    android:text="Infantil" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/family_editor_adult_options"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/FamilyLabel"
                    android:text="Shorts" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/family_tabs_bg"
                    android:orientation="horizontal"
                    android:padding="4dp">

                    <TextView
                        android:id="@+id/family_editor_shorts_show"
                        style="@style/FamilyTab"
                        android:text="Mostrar" />

                    <TextView
                        android:id="@+id/family_editor_shorts_hide"
                        style="@style/FamilyTab"
                        android:text="Ocultar" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/family_editor_kid_options"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    style="@style/FamilyLabel"
                    android:text="Edad" />

                <LinearLayout
                    android:id="@+id/family_editor_ages"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/family_tabs_bg"
                    android:orientation="horizontal"
                    android:padding="4dp">

                    <TextView style="@style/FamilyTab" android:text="Hasta 4" />
                    <TextView style="@style/FamilyTab" android:text="5 a 8" />
                    <TextView style="@style/FamilyTab" android:text="9 a 12" />
                    <TextView style="@style/FamilyTab" android:text="13 a 15" />
                </LinearLayout>

                <TextView
                    style="@style/FamilyLabel"
                    android:text="Qué puede ver" />

                <LinearLayout
                    android:id="@+id/family_editor_content"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/family_tabs_bg"
                    android:orientation="horizontal"
                    android:padding="4dp">

                    <TextView style="@style/FamilyTab" android:text="Todo menos contenido adulto" />
                    <TextView style="@style/FamilyTab" android:text="Solo canales aprobados" />
                </LinearLayout>

                <TextView
                    android:id="@+id/family_editor_content_hint"
                    android:layout_width="480dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:textColor="@color/family_text3"
                    android:textSize="13sp" />

                <TextView
                    style="@style/FamilyLabel"
                    android:text="Tiempo máximo al día" />

                <LinearLayout
                    android:id="@+id/family_editor_limits"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/family_tabs_bg"
                    android:orientation="horizontal"
                    android:padding="4dp">

                    <TextView style="@style/FamilyTab" android:text="Sin límite" />
                    <TextView style="@style/FamilyTab" android:text="30 min" />
                    <TextView style="@style/FamilyTab" android:text="1 hora" />
                    <TextView style="@style/FamilyTab" android:text="2 horas" />
                </LinearLayout>

                <TextView
                    style="@style/FamilyLabel"
                    android:text="Comentarios y chat" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/family_tabs_bg"
                    android:orientation="horizontal"
                    android:padding="4dp">

                    <TextView
                        android:id="@+id/family_editor_comments_hide"
                        style="@style/FamilyTab"
                        android:text="Ocultar" />

                    <TextView
                        android:id="@+id/family_editor_comments_show"
                        style="@style/FamilyTab"
                        android:text="Mostrar" />
                </LinearLayout>

                <TextView
                    style="@style/FamilyLabel"
                    android:text="Canales aprobados" />

                <LinearLayout
                    android:id="@+id/family_editor_channels"
                    android:layout_width="480dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:layout_width="480dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:text="Para aprobar un canal: desde un perfil de adulto, mantén pulsado OK sobre un vídeo de ese canal."
                    android:textColor="@color/family_text3"
                    android:textSize="13sp" />

                <LinearLayout
                    android:id="@+id/family_editor_pin_box"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="420dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:text="Al guardar elegirás un PIN de 4 cifras. Se pedirá para entrar en los perfiles de adulto, para dar más tiempo y para cambiar estos ajustes."
                        android:textColor="@color/family_text3"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="34dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/family_editor_save"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:background="@drawable/family_pill_red"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:paddingLeft="26dp"
                    android:paddingRight="26dp"
                    android:text="Guardar"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/family_editor_delete"
                    style="@style/FamilyTab"
                    android:layout_height="40dp"
                    android:layout_marginLeft="12dp"
                    android:text="Borrar perfil" />

                <TextView
                    android:id="@+id/family_editor_cancel"
                    style="@style/FamilyTab"
                    android:layout_height="40dp"
                    android:layout_marginLeft="12dp"
                    android:text="Cancelar" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
