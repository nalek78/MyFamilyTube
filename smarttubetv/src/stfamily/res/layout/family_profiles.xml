<?xml version="1.0" encoding="utf-8"?>
<!-- "¿Quién está viendo?" and the profile editor, shown over the home screen -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/family_bg"
    android:clickable="true">

    <LinearLayout
        android:id="@+id/family_picker"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/family_picker_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="¿Quién está viendo?"
            android:textColor="@color/family_text"
            android:textSize="30sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/family_picker_items"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="horizontal" />

        <TextView
            android:id="@+id/family_picker_manage"
            style="@style/FamilyTab"
            android:layout_marginTop="40dp"
            android:text="Gestionar perfiles" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/family_editor"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="40dp"
            android:paddingBottom="40dp">

            <TextView
                android:id="@+id/family_editor_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/family_text"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                style="@style/FamilyLabel"
                android:text="Nombre" />

            <EditText
                android:id="@+id/family_editor_name"
                android:layout_width="360dp"
                android:layout_height="48dp"
                android:background="@drawable/family_input_bg"
                android:importantForAutofill="no"
                android:inputType="textPersonName|textCapWords"
                android:maxLength="20"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:singleLine="true"
                android:textColor="@color/family_text"
                android:textColorHint="@color/family_text3"
                android:hint="Por ejemplo, Lucía"
                android:textSize="18sp" />

            <TextView
                style="@style/FamilyLabel"
                android:text="Tipo de perfil" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/family_tabs_bg"
                android:orientation="horizontal"
                android:padding="4dp">

                <TextView
                    android:id="@+id/family_editor_adult"
                    style="@style/FamilyTab"
                    android:text="Adulto" />

                <TextView
                    android:id="@+id/family_editor_kid"
                    style="@style/FamilyTab"
                    android:text="Infantil" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/family_editor_kid_options"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    style="@style/FamilyLabel"
                    android:text="Edad" />

                <LinearLayout
                    android:id="@+id/family_editor_ages"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/family_tabs_bg"
                    android:orientation="horizontal"
                    android:padding="4dp">

                    <TextView style="@style/FamilyTab" android:text="Hasta 4" />
                    <TextView style="@style/FamilyTab" android:text="5 a 8" />
                    <TextView style="@style/FamilyTab" android:text="9 a 12" />
                    <TextView style="@style/FamilyTab" android:text="13 a 15" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/family_editor_pin_box"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        style="@style/FamilyLabel"
                        android:text="PIN de control parental (4 cifras)" />

                    <EditText
                        android:id="@+id/family_editor_pin"
                        android:layout_width="200dp"
                        android:layout_height="48dp"
                        android:background="@drawable/family_input_bg"
                        android:gravity="center"
                        android:importantForAutofill="no"
                        android:inputType="numberPassword"
                        android:maxLength="4"
                        android:singleLine="true"
                        android:textColor="@color/family_text"
                        android:textSize="20sp" />

                    <TextView
                        android:layout_width="420dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:text="Se pedirá para salir de un perfil infantil y para cambiar estos ajustes."
                        android:textColor="@color/family_text3"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="34dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/family_editor_save"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:background="@drawable/family_pill_red"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:paddingLeft="26dp"
                    android:paddingRight="26dp"
                    android:text="Guardar"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/family_editor_delete"
                    style="@style/FamilyTab"
                    android:layout_height="40dp"
                    android:layout_marginLeft="12dp"
                    android:text="Borrar perfil" />

                <TextView
                    android:id="@+id/family_editor_cancel"
                    style="@style/FamilyTab"
                    android:layout_height="40dp"
                    android:layout_marginLeft="12dp"
                    android:text="Cancelar" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
