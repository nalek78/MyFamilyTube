<?xml version="1.0" encoding="utf-8"?>
<!-- Fades the hero picture into the background on the left and at the bottom -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#FF101114" android:centerColor="#80101114" android:endColor="#00101114" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="90" android:startColor="#FF101114" android:centerColor="#40101114" android:endColor="#00101114" />
        </shape>
    </item>
</layer-list>
