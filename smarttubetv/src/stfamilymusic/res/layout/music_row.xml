<?xml version="1.0" encoding="utf-8"?>
<!-- A song, a list or a channel in a list -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:background="?android:attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingLeft="16dp"
    android:paddingRight="8dp">

    <ImageView
        android:id="@+id/music_row_art"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:background="@drawable/music_art_bg"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/music_row_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/family_text"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/music_row_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/family_text3"
            android:textSize="13sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/music_row_more"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:alpha="0.6"
        android:importantForAccessibility="no"
        android:rotation="180"
        android:scaleType="center"
        android:src="@drawable/mobile_ic_back" />
</LinearLayout>
