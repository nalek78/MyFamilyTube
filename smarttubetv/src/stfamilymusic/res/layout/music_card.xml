<?xml version="1.0" encoding="utf-8"?>
<!-- A cover on a shelf: song, mix, artist, album or list -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="152dp"
    android:layout_height="wrap_content"
    android:background="?android:attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:padding="4dp">

    <FrameLayout
        android:layout_width="144dp"
        android:layout_height="144dp">

        <ImageView
            android:id="@+id/music_card_art"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/music_art_bg"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <ImageView
            android:id="@+id/music_card_playing"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_gravity="bottom|right"
            android:layout_margin="6dp"
            android:background="@drawable/music_play_bg"
            android:importantForAccessibility="no"
            android:padding="7dp"
            android:src="@drawable/mobile_ic_audio"
            android:tint="#0B0C0E"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/music_card_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:maxLines="2"
        android:textColor="@color/family_text"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/music_card_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:singleLine="true"
        android:textColor="@color/family_text3"
        android:textSize="12sp" />
</LinearLayout>
