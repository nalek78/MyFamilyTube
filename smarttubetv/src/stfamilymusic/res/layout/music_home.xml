<?xml version="1.0" encoding="utf-8"?>
<!-- My Family Music on the phone: who is listening, and how to use it in the car -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/music_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/family_bg">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="24dp">

            <ImageView
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_marginTop="24dp"
                android:importantForAccessibility="no"
                android:src="@mipmap/app_icon" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/app_name"
                android:textColor="@color/family_text"
                android:textSize="26sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="La música de YouTube en el coche, con el control parental de cada perfil"
                android:textColor="@color/family_text2"
                android:textSize="15sp" />

            <!-- Who is listening -->
            <LinearLayout
                android:id="@+id/music_profile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:background="@drawable/mobile_chip_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <TextView
                    android:id="@+id/family_profile_button"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:gravity="center"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginLeft="14dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/music_profile_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/family_text"
                        android:textSize="18sp" />

                    <TextView
                        android:id="@+id/music_profile_info"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/family_text2"
                        android:textSize="14sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cambiar"
                    android:textColor="@color/family_ring"
                    android:textSize="15sp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:lineSpacingExtra="6dp"
                android:text="1. Elige quién escucha. En los perfiles de adulto puedes poner su cuenta de Google (Cambiar › editar perfil) para tener sus listas y canales.\n2. Conecta el móvil al coche y abre My Family Music en Android Auto.\n3. Las canciones siguientes se guardan solas en el móvil para que no se corte la música sin cobertura."
                android:textColor="@color/family_text2"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/music_diagnostics"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginTop="28dp"
                android:background="?android:attr/selectableItemBackground"
                android:gravity="center"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:text="Diagnóstico"
                android:textColor="@color/family_text3"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/music_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/family_text3"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
