<?xml version="1.0" encoding="utf-8"?>
<!-- My Family Music on the phone, in the style of Spotify / YouTube Music:
     greeting, tabs chosen from what you listen to, shelves of covers, a floating mini player
     and a full player coloured after the cover. Same music as in the car. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/music_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/family_bg">

    <!-- Colour of the current cover, fading into the background (behind everything) -->
    <View
        android:id="@+id/music_glow"
        android:layout_width="match_parent"
        android:layout_height="260dp" />

    <LinearLayout
        android:id="@+id/music_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top bar -->
        <LinearLayout
            android:id="@+id/music_top"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="12dp"
            android:paddingRight="4dp">

            <ImageView
                android:id="@+id/music_back"
                style="@style/MobileIconButton"
                android:layout_marginLeft="-6dp"
                android:contentDescription="Atrás"
                android:src="@drawable/mobile_ic_back"
                android:visibility="gone" />

            <TextView
                android:id="@+id/family_profile_button"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:clickable="true"
                android:contentDescription="Cambiar de perfil"
                android:focusable="true"
                android:gravity="center"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/music_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="@color/family_text"
                android:textSize="23sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/music_search"
                style="@style/MobileIconButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="Buscar"
                android:src="@drawable/mobile_ic_search" />

            <ImageView
                android:id="@+id/music_more"
                style="@style/MobileIconButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="Más"
                android:src="@drawable/mobile_ic_more" />
        </LinearLayout>

        <!-- Search -->
        <LinearLayout
            android:id="@+id/music_search_bar"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="6dp"
            android:paddingRight="4dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/music_search_close"
                style="@style/MobileIconButton"
                android:contentDescription="Cerrar búsqueda"
                android:src="@drawable/mobile_ic_back" />

            <EditText
                android:id="@+id/music_search_field"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/mobile_search_bg"
                android:hint="¿Qué quieres escuchar?"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:singleLine="true"
                android:textColor="@color/family_text"
                android:textColorHint="@color/family_text3"
                android:textSize="16sp" />

            <ImageView
                android:id="@+id/music_mic"
                style="@style/MobileIconButton"
                android:contentDescription="Buscar por voz"
                android:src="@drawable/mobile_ic_mic" />
        </LinearLayout>

        <HorizontalScrollView
            android:id="@+id/music_tabs_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/music_tabs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingLeft="16dp"
                android:paddingTop="2dp"
                android:paddingRight="12dp"
                android:paddingBottom="6dp" />
        </HorizontalScrollView>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/music_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="16dp" />

            <ProgressBar
                android:id="@+id/music_progress"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="center"
                android:indeterminateTint="@color/music_accent"
                android:visibility="gone" />

            <TextView
                android:id="@+id/music_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:padding="32dp"
                android:textColor="@color/family_text2"
                android:textSize="16sp"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Floating mini player -->
        <FrameLayout
            android:id="@+id/music_mini"
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="8dp"
            android:layout_marginBottom="8dp"
            android:clickable="true"
            android:elevation="6dp"
            android:focusable="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="11dp"
                android:paddingRight="4dp">

                <ImageView
                    android:id="@+id/music_mini_art"
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:background="@drawable/music_art_bg"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/music_mini_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-medium"
                        android:singleLine="true"
                        android:textColor="#FFFFFF"
                        android:textSize="17sp" />

                    <TextView
                        android:id="@+id/music_mini_artist"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:textColor="#CCFFFFFF"
                        android:textSize="15sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/music_mini_play"
                    style="@style/MobileIconButton"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:scaleX="1.25"
                    android:scaleY="1.25"
                    android:contentDescription="Reproducir o pausar"
                    android:src="@drawable/mobile_ic_play" />

                <ImageView
                    android:id="@+id/music_mini_next"
                    style="@style/MobileIconButton"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:scaleX="1.25"
                    android:scaleY="1.25"
                    android:contentDescription="Siguiente"
                    android:src="@drawable/mobile_ic_next" />
            </LinearLayout>

            <!-- How much of the song has been played -->
            <View
                android:id="@+id/music_mini_track"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_gravity="bottom"
                android:layout_marginLeft="10dp"
                android:layout_marginRight="10dp"
                android:background="#40FFFFFF" />

            <View
                android:id="@+id/music_mini_progress"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_gravity="bottom"
                android:layout_marginLeft="10dp"
                android:layout_marginRight="10dp"
                android:background="#FFFFFF"
                android:scaleX="0" />
        </FrameLayout>
    </LinearLayout>

    <!-- Full player -->
    <FrameLayout
        android:id="@+id/music_player"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/family_bg"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/music_player_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingLeft="24dp"
            android:paddingTop="8dp"
            android:paddingRight="24dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginLeft="-12dp"
                android:layout_marginRight="-12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/music_player_close"
                    style="@style/MobileIconButton"
                    android:contentDescription="Cerrar"
                    android:rotation="-90"
                    android:src="@drawable/mobile_ic_back" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.1"
                        android:text="REPRODUCIENDO"
                        android:textColor="#B3FFFFFF"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/music_player_source"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-medium"
                        android:singleLine="true"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/music_player_queue"
                    style="@style/MobileIconButton"
                    android:contentDescription="A continuación"
                    android:src="@drawable/mobile_ic_library" />
            </LinearLayout>

            <!-- The cover: a square as big as fits (sized in code) -->
            <FrameLayout
                android:id="@+id/music_player_art_box"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="20dp"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/music_player_art"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_gravity="center"
                    android:background="@drawable/music_art_big_bg"
                    android:elevation="16dp"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/music_player_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="marquee"
                        android:marqueeRepeatLimit="marquee_forever"
                        android:singleLine="true"
                        android:textColor="#FFFFFF"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/music_player_artist"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:textColor="#C8FFFFFF"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/music_player_album"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:textColor="#8CFFFFFF"
                        android:textSize="13sp"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- Add the song to a list -->
                <ImageView
                    android:id="@+id/music_player_add"
                    style="@style/MobileIconButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginLeft="8dp"
                    android:layout_marginRight="-12dp"
                    android:contentDescription="Añadir a una lista"
                    android:scaleX="1.15"
                    android:scaleY="1.15"
                    android:src="@drawable/music_ic_add" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/music_player_seek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="-16dp"
                android:layout_marginTop="14dp"
                android:layout_marginRight="-16dp"
                android:progressBackgroundTint="#55FFFFFF"
                android:progressTint="#FFFFFF"
                android:thumbTint="#FFFFFF" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/music_player_time"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="0:00"
                    android:textColor="#B3FFFFFF"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/music_player_duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0:00"
                    android:textColor="#B3FFFFFF"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/music_player_prev"
                    style="@style/MobileIconButton"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:contentDescription="Anterior"
                    android:scaleX="1.3"
                    android:scaleY="1.3"
                    android:src="@drawable/mobile_ic_prev" />

                <ImageView
                    android:id="@+id/music_player_play"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_marginLeft="32dp"
                    android:layout_marginRight="32dp"
                    android:background="@drawable/music_play_white_bg"
                    android:clickable="true"
                    android:contentDescription="Reproducir o pausar"
                    android:focusable="true"
                    android:scaleType="center"
                    android:scaleX="1.2"
                    android:scaleY="1.2"
                    android:src="@drawable/mobile_ic_play"
                    android:tint="#0B0C0E" />

                <ImageView
                    android:id="@+id/music_player_next"
                    style="@style/MobileIconButton"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:contentDescription="Siguiente"
                    android:scaleX="1.3"
                    android:scaleY="1.3"
                    android:src="@drawable/mobile_ic_next" />
            </LinearLayout>
        </LinearLayout>

        <!-- «A continuación»: the queue -->
        <LinearLayout
            android:id="@+id/music_queue"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#F2101114"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="6dp">

                <ImageView
                    android:id="@+id/music_queue_close"
                    style="@style/MobileIconButton"
                    android:contentDescription="Cerrar"
                    android:rotation="-90"
                    android:src="@drawable/mobile_ic_back" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="6dp"
                    android:layout_weight="1"
                    android:text="A continuación"
                    android:textColor="@color/family_text"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/music_queue_list"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingBottom="16dp" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
